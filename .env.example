# ─────────────────────────────────────────────────────────────
#  Vishwa Golf Profile — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000

# Admin access — only this email can receive OTP login codes
ADMIN_EMAIL=vmachavarapu@gmail.com

# SendGrid (add your key here when ready)
# Get one at: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here

# The verified sender email in your SendGrid account
# Must match a Single Sender or domain you've verified in SendGrid
FROM_EMAIL=noreply@yourdomain.com
