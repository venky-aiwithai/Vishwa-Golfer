{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": "api" }
    ]
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "bash -c 'rm -rf functions/server && mkdir -p functions/server && cp -r server/* functions/server/'",
      "npm --prefix functions install"
    ]
  }
}
